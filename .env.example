# --- Секреты YandexGPT (заполнить в .env, не здесь!) ---
YC_API_KEY=your-api-key
YC_FOLDER_ID=your-folder-id

# --- Языковая модель ---
LLM_PROVIDER=yandexgpt
LLM_MODEL=yandexgpt/latest
LLM_TEMPERATURE=0.1

# --- Векторная база ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_docs

# --- Поиск и нарезка ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4